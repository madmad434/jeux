  <metadonnees>
    <titre>Anagrammes</titre>
    <description>Collection de groupes d'anagrammes en français, de 5 à 14 lettres.</description>
    <source>
      <dictionnaire>Dictionnaire Hunspell français (wooorm/dictionaries)</dictionnaire>
      <lien>https://raw.githubusercontent.com/wooorm/dictionaries/main/dictionaries/fr/index.dic</lien>
      <licence>LGPL / MPL — dictionnaire basé sur Grammalecte et Hunspell</licence>
    </source>
    <regles>
      <regle>Mots au singulier uniquement (pas de pluriels)</regle>
      <regle>Verbes à l'infinitif uniquement (pas de formes conjuguées)</regle>
      <regle>Mots communs uniquement (pas de noms propres)</regle>
      <regle>Chaque groupe contient au minimum 2 mots formant des anagrammes entre eux</regle>
    </regles>
    <statistiques>
      <total_groupes>variable selon longueur</total_groupes>
      <longueurs>5 à 14 lettres</longueurs>
    </statistiques>
  </metadonnees>

